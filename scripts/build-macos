#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
configuration=${1:-release}
swift build --package-path apps/macos -c "$configuration" --product DropDuo
bin=$(swift build --package-path apps/macos -c "$configuration" --show-bin-path)
app="dist/DropDuo.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$bin/DropDuo" "$app/Contents/MacOS/DropDuo"
cp apps/macos/Resources/Info.plist "$app/Contents/Info.plist"
codesign --force --sign "${DROPDUO_SIGN_IDENTITY:--}" "$app"
printf 'Built %s (%s signing).\n' "$app" "${DROPDUO_SIGN_IDENTITY:-development ad-hoc}"
