#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if [ -z "${ANDROID_HOME:-}" ] && [ -d "$HOME/Library/Android/sdk" ]; then
  ANDROID_HOME="$HOME/Library/Android/sdk"; export ANDROID_HOME
fi
adb get-state >/dev/null
if ! adb shell getprop ro.kernel.qemu | tr -d '\r' | grep -q '^1$'; then
  echo 'This script is for a disposable emulator only; it installs test apps and stores synthetic pairing.' >&2; exit 1
fi
swift build --package-path apps/macos --product nearport-interop
./apps/android/gradlew -p apps/android :app:assembleDebug :app:assembleDebugAndroidTest --console=plain
bin=$(swift build --package-path apps/macos --show-bin-path)
mkdir -p .artifacts
work=$(mktemp -d "$PWD/.artifacts/emulator.XXXXXX")
"$bin/nearport-interop" serve "$work" > "$work/server.log" 2>&1 &
server_pid=$!
trap 'kill "$server_pid" 2>/dev/null || true; rm -rf "$work"; adb shell rm -f /sdcard/Android/data/app.nearport.android/files/interop-ticket.txt >/dev/null 2>&1 || true' EXIT INT TERM
attempt=0
while [ ! -f "$work/ticket.txt" ]; do
  if ! kill -0 "$server_pid" 2>/dev/null; then cat "$work/server.log"; exit 1; fi
  attempt=$((attempt + 1)); [ "$attempt" -lt 100 ] || { cat "$work/server.log"; exit 1; }; sleep 0.1
done
# Emulator routes this address to the host. Physical devices must use the LAN IP.
python3 - "$work/ticket.txt" <<'PYCODE'
import base64,json,sys
from pathlib import Path
p=Path(sys.argv[1]);data=json.loads(base64.b64decode(p.read_text().split("nearport://pair/")[1]));data['host']='10.0.2.2'
p.write_text('nearport://pair/'+base64.b64encode(json.dumps(data).encode()).decode())
PYCODE
adb install -r apps/android/app/build/outputs/apk/debug/app-debug.apk
adb install -r apps/android/app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk
adb shell pm grant app.nearport.android android.permission.POST_NOTIFICATIONS
adb shell mkdir -p /sdcard/Android/data/app.nearport.android/files
adb push "$work/ticket.txt" /sdcard/Android/data/app.nearport.android/files/interop-ticket.txt >/dev/null
adb shell am instrument -w -e nearport.interop true app.nearport.android.test/androidx.test.runner.AndroidJUnitRunner | tee "$work/instrumentation.txt"
grep -q 'OK (1 test)' "$work/instrumentation.txt"
test -f "$work/passed.txt"
cat "$work/passed.txt"
printf '\n'
