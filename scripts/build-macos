#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
configuration=${1:-release}
# Releases set the version and build; local builds use the newest release tag and the commit count, as releases do.
# Release tags sit on master, so pick the highest one rather than the nearest; "-" suffixes sort before the release.
DROPDUO_VERSION=${DROPDUO_VERSION:-$(git -c versionsort.suffix=- tag --list 'v*' --sort=-v:refname 2>/dev/null | sed -n '1s/^v//p')}
DROPDUO_BUILD=${DROPDUO_BUILD:-$(git rev-list --count HEAD 2>/dev/null || echo 1)}
export DROPDUO_VERSION="${DROPDUO_VERSION:-0.0.0}" DROPDUO_BUILD
# macOS draws controls by the SDK an app records, not the SDK it was compiled with. SwiftPM's newer build system links
# without telling clang the SDK, which records the minimum macOS instead and gets the old, smaller window chrome.
sdk=$(xcrun --sdk macosx --show-sdk-path)
swift build --package-path apps/macos -c "$configuration" --product DropDuo \
  -Xswiftc -Xclang-linker -Xswiftc -isysroot -Xswiftc -Xclang-linker -Xswiftc "$sdk"
bin=$(swift build --package-path apps/macos -c "$configuration" --show-bin-path)
recorded=$(vtool -show-build "$bin/DropDuo" | awk '$1 == "sdk" { print $2 }')
expected=$(xcrun --sdk macosx --show-sdk-version)
[ "$recorded" = "$expected" ] || { echo "DropDuo recorded SDK $recorded instead of $expected." >&2; exit 1; }
app="dist/DropDuo.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
# Preserve Sparkle's versioned symlinks, helper apps and XPC services in our non-Xcode bundle.
framework="apps/macos/.build/artifacts/sparkle/Sparkle/Sparkle.xcframework/macos-arm64_x86_64/Sparkle.framework"
mkdir -p "$app/Contents/Frameworks"
rm -rf "$app/Contents/Frameworks/Sparkle.framework"
ditto "$framework" "$app/Contents/Frameworks/Sparkle.framework"
cp apps/macos/.build/artifacts/sparkle/Sparkle/LICENSE "$app/Contents/Resources/SPARKLE-LICENSE.txt"
cp "$bin/DropDuo" "$app/Contents/MacOS/DropDuo"
# Remove SwiftPM's developer-machine framework search path from the packaged executable.
python3 - "$app/Contents/MacOS/DropDuo" <<'PY'
import re, subprocess, sys
binary = sys.argv[1]
commands = subprocess.check_output(['otool', '-l', binary], text=True)
for path in re.findall(r'cmd LC_RPATH\n.*?path (.*?) \(offset', commands, re.S):
    if 'PackageFrameworks' in path:
        subprocess.run(['install_name_tool', '-delete_rpath', path, binary], check=True)
PY
cp apps/macos/Resources/Info.plist "$app/Contents/Info.plist"
python3 - "$app/Contents/Info.plist" <<'PY'
import base64, os, plistlib, sys
from pathlib import Path
name = os.environ['DROPDUO_VERSION']
path = Path(sys.argv[1])
info = plistlib.loads(path.read_bytes())
info['CFBundleShortVersionString'] = name.split('-', 1)[0]
info['CFBundleVersion'] = os.environ['DROPDUO_BUILD']
info['DropDuoVersion'] = name
info['SUFeedURL'] = 'https://github.com/rohit-yadavv/dropduo/releases/latest/download/appcast-mac.xml'
key = os.environ.get('DROPDUO_UPDATE_PUBLIC_KEY', '').strip()
if key:
    if len(base64.b64decode(key, validate=True)) != 32:
        raise SystemExit('Invalid Sparkle public key.')
    info['SUPublicEDKey'] = key
elif os.environ.get('DROPDUO_SIGN_IDENTITY', '-') != '-':
    raise SystemExit('Signed builds require DROPDUO_UPDATE_PUBLIC_KEY.')
info['SUEnableAutomaticChecks'] = False # AppUpdater makes silent, daily availability probes.
info['SUAutomaticallyUpdate'] = False
info['SUAllowsAutomaticUpdates'] = False
info['SUSendProfileInfo'] = False
info['SURequireSignedFeed'] = True
info['SUVerifyUpdateBeforeExtraction'] = True
path.write_bytes(plistlib.dumps(info))
PY
cp apps/macos/Resources/DropDuo.icns "$app/Contents/Resources/DropDuo.icns"
# Images live directly in the app's Resources so Bundle.main finds them; no nested SwiftPM bundle to lose.
rm -rf "$app/Contents/Resources/DropDuo_DropDuo.bundle"
cp apps/macos/Sources/DropDuo/Resources/*.png "$app/Contents/Resources/"
# Releases upload only the app, so its license and notices travel inside it.
cp LICENSE "$app/Contents/Resources/"
# Releases sign with DropDuo's own certificate, or Developer ID once Apple signing is set up; local builds sign ad hoc.
# Only Developer ID gets the hardened runtime notarization needs: its library validation stops a self-signed app from
# loading Sparkle, because the certificate has no Apple team ID.
sign() {
  case "${DROPDUO_SIGN_IDENTITY:--}" in
    'Developer ID Application:'*) codesign --force --options runtime --timestamp --sign "$DROPDUO_SIGN_IDENTITY" --preserve-metadata=entitlements "$1" ;;
    *) codesign --force --sign "${DROPDUO_SIGN_IDENTITY:--}" --preserve-metadata=entitlements "$1" ;;
  esac
}
embedded="$app/Contents/Frameworks/Sparkle.framework/Versions/B"
sign "$embedded/XPCServices/Downloader.xpc"
sign "$embedded/XPCServices/Installer.xpc"
sign "$embedded/Autoupdate"
sign "$embedded/Updater.app"
sign "$app/Contents/Frameworks/Sparkle.framework"
sign "$app"
printf 'Built %s (%s signing).\n' "$app" "${DROPDUO_SIGN_IDENTITY:-development ad-hoc}"
