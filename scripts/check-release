#!/usr/bin/env python3
"""Validate release metadata without creating a tag or publishing anything."""
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
VERSION = re.compile(r"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-(alpha|beta|rc)\.([1-9]\d*))?$")


def validate(tag, mode, root=ROOT):
    version = dict(line.split("=", 1) for line in (root / "version.properties").read_text().splitlines() if "=" in line)
    name = version["versionName"]
    if not VERSION.fullmatch(name) or tag != "v" + name:
        raise ValueError("Tag must equal v + versionName (SemVer or alpha.N / beta.N / rc.N).")
    if not version["versionCode"].isdigit() or not 1 <= int(version["versionCode"]) <= 2100000000:
        raise ValueError("versionCode must be a positive Android-compatible integer.")
    if mode not in ("development", "distribution"):
        raise ValueError("Unknown release mode.")
    prerelease = "-" in name
    if mode == "development" and not prerelease:
        raise ValueError("Stable tags require distribution signing; development mode is prerelease-only.")
    if f"## {name}" not in (root / "CHANGELOG.md").read_text().splitlines():
        raise ValueError("Add a released changelog section named ## " + name + " before tagging.")
    return prerelease


if __name__ == "__main__":
    try:
        prerelease = validate(sys.argv[1], sys.argv[2])
    except (ValueError, KeyError, IndexError) as error:
        sys.exit(str(error))
    print("Release metadata valid; prerelease=" + str(prerelease).lower())
