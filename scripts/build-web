#!/usr/bin/env python3
"""Assemble the static site in apps/web into dist/web and check its local references."""
from html.parser import HTMLParser
from pathlib import Path
import re
import shutil
import sys

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "apps" / "web"
OUT = ROOT / "dist" / "web"
BRAND = ["dropduo-icon.svg", "dropduo-icon.png"]


class References(HTMLParser):
    def __init__(self):
        super().__init__()
        self.refs = []
        self.ids = set()

    def handle_starttag(self, tag, attrs):
        for name, value in attrs:
            if name == "id":
                self.ids.add(value)
            elif name in ("href", "src", "srcset") and value:
                self.refs.append(value.split()[0])


def main():
    if OUT.exists():
        shutil.rmtree(OUT)
    shutil.copytree(SOURCE, OUT, ignore=shutil.ignore_patterns("README.md", "AGENTS.md", ".DS_Store"))
    (OUT / "assets/brand").mkdir(parents=True, exist_ok=True)
    for name in BRAND:
        shutil.copy2(ROOT / "branding" / name, OUT / "assets/brand" / name)

    html = (OUT / "index.html").read_text()
    css = (OUT / "styles.css").read_text()
    parser = References()
    parser.feed(html)
    errors = []
    for ref in parser.refs:
        if ref.startswith("#"):
            if len(ref) > 1 and ref[1:] not in parser.ids:
                errors.append(f"missing anchor {ref}")
            continue
        if re.match(r"^[a-zA-Z][a-zA-Z0-9+.-]*:", ref) or "/" not in ref and "." not in ref:
            continue
        path = ref.split("#")[0]
        if not (OUT / path).is_file():
            errors.append(f"missing file {ref}")
        elif path == "assets/icons.svg" and "#" in ref:
            symbol = ref.split("#")[1]
            if f'id="{symbol}"' not in (OUT / path).read_text():
                errors.append(f"missing icon {symbol}")
    for url in re.findall(r'url\("([^"]+)"\)', css):
        if not (OUT / url).is_file():
            errors.append(f"missing stylesheet asset {url}")
    for name in ("index.html", "main.js"):
        if re.search("[–—]", (OUT / name).read_text()):
            errors.append(f"{name} contains an en or em dash; use plain punctuation")
    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 1
    print(f"Built {OUT.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
