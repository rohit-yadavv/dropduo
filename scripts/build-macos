#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
configuration=${1:-release}
swift build --package-path apps/macos -c "$configuration" --product DropDuo
bin=$(swift build --package-path apps/macos -c "$configuration" --show-bin-path)
app="dist/DropDuo.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$bin/DropDuo" "$app/Contents/MacOS/DropDuo"
cp apps/macos/Resources/Info.plist "$app/Contents/Info.plist"
python3 - "$app/Contents/Info.plist" <<'PY'
import plistlib, sys
from pathlib import Path
version = dict(line.split('=', 1) for line in Path('version.properties').read_text().splitlines() if '=' in line)
path = Path(sys.argv[1])
info = plistlib.loads(path.read_bytes())
info['CFBundleShortVersionString'] = version['versionName'].split('-', 1)[0]
info['CFBundleVersion'] = version['versionCode']
info['DropDuoVersion'] = version['versionName']
path.write_bytes(plistlib.dumps(info))
PY
cp apps/macos/Resources/DropDuo.icns "$app/Contents/Resources/DropDuo.icns"
# Images live directly in the app's Resources so Bundle.main finds them; no nested SwiftPM bundle to lose.
rm -rf "$app/Contents/Resources/DropDuo_DropDuo.bundle"
cp apps/macos/Sources/DropDuo/Resources/*.png "$app/Contents/Resources/"
if [ "${DROPDUO_SIGN_IDENTITY:--}" = '-' ]; then
  codesign --force --sign - "$app"
else
  codesign --force --options runtime --timestamp --sign "$DROPDUO_SIGN_IDENTITY" "$app"
fi
printf 'Built %s (%s signing).\n' "$app" "${DROPDUO_SIGN_IDENTITY:-development ad-hoc}"
