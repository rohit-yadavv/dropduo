#!/usr/bin/env python3
"""Export the shared vector geometry. macOS additionally renders PNGs and ICNS."""
import json
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
MARK = json.loads((ROOT / "branding/mark.json").read_text())
COLORS = MARK["colors"]
PATHS = [" ".join(str(value) for command in item["commands"] for value in command)
         for item in MARK["paths"]]
CLIP = MARK["frontClip"]


def write(relative, value):
    path = ROOT / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(value + "\n")


def svg(background=False, monochrome=False):
    fills = [COLORS["ink"], COLORS["ink"] if monochrome else COLORS["cobalt"]]
    shapes = "\n".join(f'<path fill="{fill}" fill-rule="evenodd" d="{path}"/>'
                       for fill, path in zip(fills, PATHS))
    tile = f'<rect width="1024" height="1024" rx="220" fill="{COLORS["background"]}"/>' if background else ""
    return f'''<!-- Generated by scripts/generate-branding; edit branding/mark.json. -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024" role="img" aria-label="DropDuo">
<defs><clipPath id="front"><rect x="{CLIP[0]}" y="{CLIP[1]}" width="{CLIP[2]}" height="{CLIP[3]}"/></clipPath></defs>
{tile}<g transform="translate(0 {MARK['offsetY']})">
{shapes}
<path fill="{fills[0]}" fill-rule="evenodd" d="{PATHS[0]}" clip-path="url(#front)"/>
</g></svg>'''


def vector(monochrome=False, adaptive=False):
    # A 57dp mark centered in the adaptive icon's 108dp viewport.
    # The exact geometry spans 700x737 units; its diagonal corners fit the safe zone.
    group = ('android:scaleX="0.077" android:scaleY="0.077" '
             'android:translateX="14.576" android:translateY="13.768"') if adaptive else f'android:translateY="{MARK["offsetY"]}"'
    viewport = 108 if adaptive else 1024
    size = 108 if adaptive else 48
    fills = ["#FFFFFF", "#FFFFFF"] if monochrome else [COLORS["ink"], COLORS["cobalt"]]
    shapes = "\n".join(f'    <path android:fillColor="{fill}" android:fillType="evenOdd" android:pathData="{path}"/>'
                       for fill, path in zip(fills, PATHS))
    x, y, w, h = CLIP
    return f'''<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by scripts/generate-branding; edit branding/mark.json. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android" android:width="{size}dp" android:height="{size}dp" android:viewportWidth="{viewport}" android:viewportHeight="{viewport}">
  <group {group}>
{shapes}
    <group>
      <clip-path android:pathData="M{x},{y} h{w} v{h} h-{w} Z"/>
      <path android:fillColor="{fills[0]}" android:fillType="evenOdd" android:pathData="{PATHS[0]}"/>
    </group>
  </group>
</vector>'''


write("branding/dropduo-mark.svg", svg())
write("branding/dropduo-icon.svg", svg(background=True))
write("branding/dropduo-monochrome.svg", svg(monochrome=True))
res = "apps/android/app/src/main/res"
write(f"{res}/drawable/ic_dropduo.xml", vector())
write(f"{res}/drawable/ic_dropduo_notification.xml", vector(monochrome=True))
write(f"{res}/drawable/ic_launcher_foreground.xml", vector(adaptive=True))
write(f"{res}/drawable/ic_launcher_monochrome.xml", vector(monochrome=True, adaptive=True))
for directory, mono in [("mipmap-anydpi-v26", False), ("mipmap-anydpi-v33", True)]:
    monochrome = '\n    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />' if mono else ""
    write(f"{res}/{directory}/ic_launcher.xml", f'''<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />{monochrome}
</adaptive-icon>''')
if sys.platform == "darwin":
    subprocess.run(["swift", str(ROOT / "scripts/render-branding.swift"), str(ROOT)], check=True)
else:
    print("Exported SVG and Android vectors. Regenerate macOS bitmaps on a Mac.")
